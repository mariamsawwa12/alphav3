NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ==========================================
# MySQL Database
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alpha
DB_USER=alpha_app
DB_PASSWORD=replace_with_password
DB_CONNECTION_LIMIT=10

# ==========================================
# JWT Authentication (required — no defaults)
# ==========================================
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# Auth / hashing
# ==========================================
BCRYPT_SALT_ROUNDS=10

# ==========================================
# n8n webhooks
# ==========================================
N8N_OTP_WEBHOOK_URL=
N8N_WEBHOOK_URL=
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_TIMEOUT_MS=15000
N8N_CHAT_MAX_RETRIES=1
CHAT_STORE_FULL_PAYLOAD=false
N8N_ANALYSIS_WEBHOOK_URL=
N8N_ANALYSIS_TIMEOUT_MS=30000
ANALYSIS_AUDIO_ALLOWED_HOSTS=
